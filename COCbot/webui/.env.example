# COCbot/webui/.env — biến môi trường cho workflow web UI.
# Copy file này thành ".env" rồi sửa theo nhu cầu; biến môi trường
# đặt sẵn trong shell LUÔN thắng giá trị trong file này.

# Dev hot-reload: trỏ vào Vite dev server (bỏ trống để dùng bản build).
WEBUI_DEV_URL=

# Kích thước cửa sổ (mặc định 480x670).
WEBUI_WIDTH=480
WEBUI_HEIGHT=670
